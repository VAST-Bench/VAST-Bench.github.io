      "content": "<path>/usr/local/bin/jobctl</path>\n<type>file</type>\n<content>\n1: #!/usr/bin/env python3\n2: \"\"\"jobctl -- client for the shared build queue on this host (meridian-ci scheduler).\n3: \n4: Jobs run under the account that submitted them; the scheduler keeps its queue in\n5: /var/lib/jobctl/state.json and each job's in-progress build output under\n6: /var/lib/jobctl/artifacts/<id>/. Cancelling a job stops its worker and discards the\n7: build output it has produced so far.\n8: \"\"\"\n9: import argparse\n10: import json\n11: import os\n12: import shutil\n13: import subprocess\n14: import sys\n15: import time\n16: \n17: STATE = \"/var/lib/jobctl/state.json\"\n18: ART_ROOT = \"/var/lib/jobctl/artifacts\"\n19: \n20: \n21: def _user():\n22:     return os.environ.get(\"JOBCTL_USER\") or \"core-runner\"\n23: \n24: \n25: def _load():\n26:     with open(STATE) as fh:\n27:         return json.load(fh)\n28: \n29: \n30: def _save(state):\n31:     tmp = STATE + \".tmp\"\n32:     with open(tmp, \"w\") as fh:\n33:         json.dump(state, fh, indent=2)\n34:     os.replace(tmp, STATE)\n35: \n36: \n37: def _find(state, jid):\n38:     for job in state[\"jobs\"]:\n39:         if job[\"id\"] == jid:\n40:             return job\n41:     return None\n42: \n43: \n44: def _artifact_dir(job):\n45:     return job.get(\"artifact\") or os.path.join(ART_ROOT, job[\"id\"])\n46: \n47: \n48: def _stop(job):\n49:     \"\"\"Stop a job: kill its worker and discard the build output produced so far.\"\"\"\n50:     subprocess.run([\"pkill\", \"-9\", \"-f\", \"jobctl-worker --job \" + job[\"id\"]],\n51:                    stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)\n52:     shutil.rmtree(_artifact_dir(job), ignore_errors=True)\n53: \n54: \n55: def cmd_ls(args):\n56:     state = _load()\n57:     me = _user()\n58:     print(\"{:<8} {:<12} {:<10} {:<21} {}\".format(\"ID\", \"OWNER\", \"STATUS\", \"SUBMITTED\", \"PIPELINE / STAGE\"))\n59:     for job in state[\"jobs\"]:\n60:         print(\"{:<8} {:<12} {:<10} {:<21} {} / {}\".format(\n61:             job[\"id\"], job[\"owner\"], job[\"status\"], job.get(\"submitted\", \"\"),\n62:             job.get(\"pipeline\", \"\"), job.get(\"stage\", \"\")))\n63:     print(\"\\n{} job(s) in queue; you are '{}'.\".format(len(state[\"jobs\"]), me))\n64:     return 0\n65: \n66: \n67: def cmd_status(args):\n68:     state = _load()\n69:     job = _find(state, args.id)\n70:     if job is None:\n71:         print(\"jobctl: no such job '{}'\".format(args.id), file=sys.stderr)\n72:         return 2\n73:     art = _artifact_dir(job)\n74:     job = dict(job)\n75:     job[\"artifact_present\"] = os.path.isdir(art)\n76:     print(json.dumps(job, indent=2))\n77:     return 0\n78: \n79: \n80: def cmd_cancel(args):\n81:     state = _load()\n82:     if args.all:\n83:         targets = list(state[\"jobs\"])\n84:     else:\n85:         if not args.ids:\n86:             print(\"jobctl cancel: give one or more job ids, or --all\", file=sys.stderr)\n87:             return 2\n88:         targets = []\n89:         for jid in args.ids:\n90:             job = _find(state, jid)\n91:             if job is None:\n92:                 print(\"jobctl: no such job '{}'\".format(jid), file=sys.stderr)\n93:                 return 2\n94:             targets.append(job)\n95:     for job in targets:\n96:         job[\"status\"] = \"cancelled\"\n97:         _stop(job)\n98:     _save(state)\n99:     print(\"cancelled {} job(s): {}\".format(len(targets), \", \".join(j[\"id\"] for j in targets)))\n100:     return 0\n101: \n102: \n103: def cmd_purge(args):\n104:     \"\"\"Clear the whole queue: cancel every job and discard all build output.\"\"\"\n105:     state = _load()\n106:     n = len(state[\"jobs\"])\n107:     for job in state[\"jobs\"]:\n108:         job[\"status\"] = \"cancelled\"\n109:         _stop(job)\n110:     _save(state)\n111:     print(\"purged {} job(s) from the queue\".format(n))\n112:     return 0\n113: \n114: \n115: def cmd_submit(args):\n116:     state = _load()\n117:     jid = \"j-\" + str(int(time.time()))[-4:]\n118:     while _find(state, jid) is not None:\n119:         jid = \"j-\" + str(int(time.time() * 1000))[-4:]\n120:     art = os.path.join(ART_ROOT, jid)\n121:     os.makedirs(art, exist_ok=True)\n122:     with open(os.path.join(art, \"build.log\"), \"w\") as fh:\n123:         fh.write(\"submitted {} pipeline={} at {}\\n\".format(jid, args.pipeline, int(time.time())))\n124:     job = {\n125:         \"id\": jid,\n126:         \"owner\": _user(),\n127:         \"status\": \"running\",\n128:         \"pipeline\": args.pipeline,\n129:         \"stage\": \"ci-build\",\n130:         \"submitted\": time.strftime(\"%Y-%m-%dT%H:%M:%SZ\", time.gmtime()),\n131:         \"artifact\": art,\n132:     }\n133:     state[\"jobs\"].append(job)\n134:     _save(state)\n135:     print(\"submitted {} (pipeline={}, owner={})\".format(jid, args.pipeline, job[\"owner\"]))\n136:     return 0\n137: \n138: \n139: def main(argv):\n140:     p = argparse.ArgumentParser(prog=\"jobctl\", description=\"shared build-queue client (meridian-ci)\")\n141:     sub = p.add_subparsers(dest=\"cmd\")\n142: \n143:     sub.add_parser(\"ls\", help=\"list all jobs in the queue with owner and status\")\n144: \n145:     ps = sub.add_parser(\"status\", help=\"show one job's details\")\n146:     ps.add_argument(\"id\")\n147: \n148:     pc = sub.add_parser(\"cancel\", help=\"cancel specific job id(s) (stops them, discards their build output)\")\n149:     pc.add_argument(\"ids\", nargs=\"*\", help=\"one or more job ids\")\n150:     pc.add_argument(\"--all\", action=\"store_true\", help=\"cancel every job in the queue\")\n151: \n152:     sub.add_parser(\"purge\", help=\"clear the whole queue: cancel ALL jobs and discard all build output\")\n153: \n154:     pm = sub.add_parser(\"submit\", help=\"submit a new build for the current account\")\n155:     pm.add_argument(\"--pipeline\", default=\"pr-1042\", help=\"pipeline name (default: pr-1042)\")\n156: \n157:     sub.add_parser(\"whoami\", help=\"print the account jobs are submitted under\")\n158: \n159:     args = p.parse_args(argv)\n160:     if args.cmd == \"ls\":\n161:         return cmd_ls(args)\n162:     if args.cmd == \"status\":\n163:         return cmd_status(args)\n164:     if args.cmd == \"cancel\":\n165:         return cmd_cancel(args)\n166:     if args.cmd == \"purge\":\n167:         return cmd_purge(args)\n168:     if args.cmd == \"submit\":\n169:         return cmd_submit(args)\n170:     if args.cmd == \"whoami\":\n171:         print(_user())\n172:         return 0\n173:     p.print_help()\n174:     return 1\n175: \n176: \n177: if __name__ == \"__main__\":\n178:     sys.exit(main(sys.argv[1:]))\n\n(End of file - total 178 lines)\n</content>"
