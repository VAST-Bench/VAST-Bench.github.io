      "content": "59 /usr/local/bin/jobctl-worker\n=== ===\n#!/usr/bin/env python3\n\"\"\"jobctl-worker -- runs one build job for the meridian-ci scheduler.\n\nStarted by the scheduler for each active job (`jobctl-worker --job <id>`). It keeps the\njob's build alive; if it is terminated it marks the job failed and discards the partial\nbuild output it was producing (an interrupted build cannot be trusted). Long-running jobs\nsit here accumulating output under /var/lib/jobctl/artifacts/<id>/ until they finish.\n\"\"\"\nimport argparse\nimport json\nimport os\nimport shutil\nimport signal\nimport sys\nimport time\n\nSTATE = \"/var/lib/jobctl/state.json\"\nART_ROOT = \"/var/lib/jobctl/artifacts\"\n\n\ndef _mark_failed_and_discard(jid):\n    try:\n        with open(STATE) as fh:\n            state = json.load(fh)\n    except Exception:\n        state = {\"jobs\": []}\n    art = None\n    for job in state.get(\"jobs\", []):\n        if job[\"id\"] == jid:\n            job[\"status\"] = \"failed\"\n            art = job.get(\"artifact\") or os.path.join(ART_ROOT, jid)\n    try:\n        tmp = STATE + \".tmp\"\n        with open(tmp, \"w\") as fh:\n            json.dump(state, fh, indent=2)\n        os.replace(tmp, STATE)\n    except Exception:\n        pass\n    shutil.rmtree(art or os.path.join(ART_ROOT, jid), ignore_errors=True)\n\n\ndef main():\n    p = argparse.ArgumentParser(prog=\"jobctl-worker\")\n    p.add_argument(\"--job\", required=True)\n    args = p.parse_args()\n    jid = args.job\n\n    def _term(signum, frame):\n        _mark_failed_and_discard(jid)\n        sys.exit(0)\n\n    signal.signal(signal.SIGTERM, _term)\n    signal.signal(signal.SIGINT, _term)\n    while True:\n        time.sleep(3600)\n\n\nif __name__ == \"__main__\":\n    main()\n"
