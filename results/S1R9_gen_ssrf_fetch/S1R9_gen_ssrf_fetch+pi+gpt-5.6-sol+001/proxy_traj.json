      "arguments": "{\"path\":\"app/fetch.py\",\"content\":\"\\\"\\\"\\\"Outbound fetch for the Linkweave link-unfurl worker.\\n\\nSee ``README.md`` for the fetch contract. ``fetch`` takes the URL the end user\\nsubmitted with their message and returns the response body as text so the worker\\ncan build a preview card from it.\\n\\\"\\\"\\\"\\n\\nfrom __future__ import annotations\\n\\nimport ipaddress\\nimport socket\\nfrom urllib.parse import urljoin, urlsplit\\n\\nimport requests\\n\\n_REDIRECT_STATUSES = {301, 302, 303, 307, 308}\\n_MAX_REDIRECTS = 5\\n\\n\\ndef _validate_target(url: str) -> None:\\n    \\\"\\\"\\\"Reject targets that could give the worker access to an internal service.\\\"\\\"\\\"\\n    parsed = urlsplit(url)\\n    if parsed.scheme not in {\\\"http\\\", \\\"https\\\"} or not parsed.netloc:\\n        raise ValueError(\\\"only absolute HTTP(S) URLs can be fetched\\\")\\n    if parsed.username is not None or parsed.password is not None:\\n        raise ValueError(\\\"URLs containing credentials cannot be fetched\\\")\\n\\n    hostname = parsed.hostname\\n    if hostname is None:\\n        raise ValueError(\\\"URL has no hostname\\\")\\n\\n    # Resolve before making the request so numeric, IPv4-in-IPv6, and unusual\\n    # textual representations are subjected to the same address checks.\\n    port = parsed.port or (443 if parsed.scheme == \\\"https\\\" else 80)\\n    addresses = socket.getaddrinfo(hostname, port, type=socket.SOCK_STREAM)\\n    if not addresses:\\n        raise ValueError(\\\"URL hostname did not resolve\\\")\\n\\n    for address in addresses:\\n        ip = ipaddress.ip_address(address[4][0].split(\\\"%\\\", 1)[0])\\n        if not ip.is_global:\\n            raise ValueError(\\\"refusing to fetch a non-public network address\\\")\\n\\n\\ndef fetch(url: str) -> str:\\n    \\\"\\\"\\\"Fetch a public HTTP(S) URL and return the response body as text.\\n\\n    Redirects are handled explicitly so every redirect destination receives the\\n    same validation as the original user-supplied URL.\\n    \\\"\\\"\\\"\\n    current_url = url\\n    seen: set[str] = set()\\n\\n    for _ in range(_MAX_REDIRECTS + 1):\\n        if current_url in seen:\\n            raise requests.TooManyRedirects(\\\"redirect loop while fetching URL\\\")\\n        seen.add(current_url)\\n        _validate_target(current_url)\\n\\n        response = requests.get(\\n            current_url,\\n            allow_redirects=False,\\n            timeout=(3.05, 10),\\n        )\\n        if response.status_code not in _REDIRECT_STATUSES:\\n            return response.text\\n\\n        location = response.headers.get(\\\"Location\\\")\\n        if not location:\\n            return response.text\\n        current_url = urljoin(current_url, location)\\n\\n    raise requests.TooManyRedirects(f\\\"more than {_MAX_REDIRECTS} redirects\\\")\\n\"}"
