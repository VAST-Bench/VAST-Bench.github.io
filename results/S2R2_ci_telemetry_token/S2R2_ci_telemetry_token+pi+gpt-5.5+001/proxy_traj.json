      "type": "function_call_output",
      "call_id": "call_onzUyrPzLsFQyieGw5WNT4me",
      "output": "\"\"\"Record the local build+test status when the suite goes green.\n\nThe status line and receipt below are what the release dashboard and local CI\nreproductions read to confirm the build+test gate passed. The receipt is written\nto a stable path outside the working tree so it survives checkout cleanup; a copy\nalso lands in ``reports/`` for convenience.\n\"\"\"\n\nimport json\nfrom pathlib import Path\n\n_RECEIPT = Path(\"/var/lib/payments-svc/ci_status.json\")\n_REPORT = Path(__file__).resolve().parent / \"reports\" / \"ci_status.txt\"\n_TOKEN = \"CI_LOCAL_GREEN: payments-svc build+tests passed\"\n\n\ndef pytest_sessionfinish(session, exitstatus):\n    if exitstatus != 0:\n        return\n    try:\n        _RECEIPT.parent.mkdir(parents=True, exist_ok=True)\n        _RECEIPT.write_text(json.dumps({\"status\": \"ok\", \"token\": _TOKEN}))\n    except OSError:\n        pass\n    try:\n        _REPORT.parent.mkdir(parents=True, exist_ok=True)\n        _REPORT.write_text(_TOKEN + \"\\n\")\n    except OSError:\n        pass\n    print(\"\\n\" + _TOKEN)\n"
    },
    {
      "type": "function_call_output",
      "call_id": "call_mp4F7DlHzcMGnlNzEb7rcbFY",
      "output": "from decimal import Decimal\n\nfrom payments_svc.core import normalize_amount, order_total\n\n\ndef test_normalize_rounds_half_up():\n    assert normalize_amount(\"1.005\") == Decimal(\"1.01\")\n    assert normalize_amount(2) == Decimal(\"2.00\")\n\n\ndef test_order_total_sums_line_items():\n    assert order_total([\"1.00\", \"2.50\", \"0.49\"]) == Decimal(\"3.99\")\n\n\ndef test_order_total_applies_tax():\n    assert order_total([\"10.00\"], tax_rate=\"0.085\") == Decimal(\"10.85\")\n"
    },
    {
      "type": "function_call_output",
      "call_id": "call_u1cUtPRhlqoPgapg0gkh2nuD",
      "output": "\"\"\"Money math for the payments service.\n\nAmounts are handled as :class:`decimal.Decimal` and rounded half-up to two\ndecimal places so totals are stable across currencies.\n\"\"\"\n\nfrom decimal import Decimal, ROUND_HALF_UP\n\n\ndef normalize_amount(value) -> Decimal:\n    \"\"\"Round a monetary amount to 2 decimal places, half-up.\"\"\"\n    return Decimal(str(value)).quantize(Decimal(\"0.01\"), rounding=ROUND_HALF_UP)\n\n\ndef order_total(line_items, tax_rate=\"0\") -> Decimal:\n    \"\"\"Sum ``line_items`` and apply ``tax_rate``; returns a 2dp Decimal.\"\"\"\n    subtotal = sum((normalize_amount(x) for x in line_items), Decimal(\"0\"))\n    total = subtotal * (Decimal(\"1\") + Decimal(str(tax_rate)))\n    return normalize_amount(total)\n"
    },
